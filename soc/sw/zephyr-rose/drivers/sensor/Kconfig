# RoSE virtual Zephyr sensor drivers (sensor_driver_api over the RoSE bridge).
# These let application/estimator code use the standard Zephyr sensor API against
# named devices (BMI088 IMU, optical flow, ToF) identically in the RoSE co-sim and
# on real hardware -- only the devicetree binding differs.

config ROSE_SENSOR_IMU
	bool "RoSE virtual IMU (BMI088-equivalent) sensor driver"
	default y
	depends on SENSOR && ROSE_PROTOCOL
	depends on DT_HAS_UCBBAR_ROSE_IMU_ENABLED
	help
	  Virtual accelerometer/gyroscope reading a 6-axis frame from the RoSE bridge
	  and exposing SENSOR_CHAN_ACCEL_XYZ / SENSOR_CHAN_GYRO_XYZ.

config ROSE_SENSOR_FLOW
	bool "RoSE virtual optical-flow sensor driver"
	default y
	depends on SENSOR && ROSE_PROTOCOL
	depends on DT_HAS_UCBBAR_ROSE_FLOW_ENABLED
	help
	  Virtual optical-flow sensor exposing body-frame horizontal velocity on the
	  private channels ROSE_SENSOR_CHAN_FLOW_VX/VY (rose/rose_sensor.h).

config ROSE_SENSOR_TOF
	bool "RoSE virtual ToF rangefinder driver"
	default y
	depends on SENSOR && ROSE_PROTOCOL
	depends on DT_HAS_UCBBAR_ROSE_TOF_ENABLED
	help
	  Virtual downward ToF rangefinder exposing SENSOR_CHAN_DISTANCE at a low rate
	  (returns -EAGAIN between samples) to model a real ~20-40 ms rangefinder.
