"""Emit kernels.h + kernels.c for a model IR.

Two orthogonal axes:

  --backend reference|llm           where do kernel implementations come from
  --target  scalar|rvv|...          which HW backend they target

Backends are declared in modelblaster/pipeline/backends.py. Each carries its own
optimization guide (used in correctness AND optimize prompts), prj.conf
overlay, kernel-only compile flags, spike --isa args, and verify routing
(host_ctypes for natively-runnable code, spike_harness for code that needs
to be cross-compiled and exercised on spike).

Optimize phase (--optimize) runs a beam search over LLM-proposed faster
equivalents, gated by per-op cycle measurement on spike with the right
backend args. Tunable via --beam, --expansions, --iterations.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
from typing import Optional

from modelblaster.pipeline import backends as backends_mod
from modelblaster.pipeline.backends import (
    Backend, VERIFY_HOST_CTYPES, VERIFY_SPIKE_HARNESS,
)
from modelblaster.pipeline.bedrock_client import extract_code_block
from modelblaster.pipeline.llm_client import LLMClient, make_llm_client
from modelblaster.pipeline.reference_kernels import (
    AccuracyClass, ACCURACY_CLASS_ATOL,
    KERNEL_SPECS, KernelSpec, shapes_from_ir,
)
from modelblaster.pipeline.verify_kernel import verify as host_verify, VerifyResult


# Curated kernel files self-declare their accuracy class via a header
# comment, e.g. `/* accuracy_class: bit_exact */`. Parsed here so the
# selection pass can drop curated kernels that don't meet a tightened
# `--max-accuracy-class`.
_ACCURACY_CLASS_RE = re.compile(
    r"/\*\s*accuracy_class\s*:\s*([a-zA-Z_]+)\s*\*/"
)


def _parse_curated_accuracy_class(src: str) -> Optional[AccuracyClass]:
    m = _ACCURACY_CLASS_RE.search(src)
    if not m:
        return None
    try:
        return AccuracyClass.parse(m.group(1))
    except ValueError:
        return None


HEADER = "/* @generated by modelblaster/pipeline/generate_kernels.py — do not edit. */"

PROMPTS_DIR = os.path.join(os.path.dirname(__file__), "prompts")


def _verify_timeout() -> float:
    """Per-spike-run timeout (seconds) for the verify build_and_run callsites.

    Verify only checks *correctness*, not performance, so it can use a
    tighter budget than the final profile run (SPIKE_TIMEOUT).

    Sizing rationale (spike 1.1.1-dev, VLEN=128 default, softfloat):
      * A vectorized fp16 GEMM at 2048×2048 processes 268M iterations of
        vl=32 element ops; softfloat simulation runs at ~100M element ops/s
        → ~172 s on spike.  Scalar triple-loop takes ~860 s.
      * 300 s cap: accepts all vectorized kernels (<200 s), rejects scalar
        (>800 s) with actionable feedback to use RVV widening intrinsics.

    Override via SPIKE_VERIFY_TIMEOUT (verify only) or SPIKE_TIMEOUT."""
    if "SPIKE_VERIFY_TIMEOUT" in os.environ:
        return float(os.environ["SPIKE_VERIFY_TIMEOUT"])
    return min(float(os.environ.get("SPIKE_TIMEOUT", "300")), 300.0)


# ---------------------------------------------------------------------------
# Prompt scaffolding (shared by correctness + optimize phases)
# ---------------------------------------------------------------------------

def _load_backend_guide(backend: Backend) -> str:
    path = os.path.join(PROMPTS_DIR, backend.optimization_guide)
    with open(path) as f:
        return f.read()


def _correctness_system_prompt(backend: Backend, guide: str) -> str:
    return f"""\
You are a senior C99 programmer specializing in correct numerical kernels for
embedded RISC-V (rv64imafdc) running under Zephyr, targeting the **{backend.name}**
HW backend ({backend.description}). Your output is compiled with -O2,
linked into a Zephyr application, run on a spike RISC-V simulator, and
validated against a reference implementation at multiple shapes
(atol=1e-4, rtol=1e-3).

The guide below tells you what code style and intrinsics are acceptable for
this target. Follow it.

----- BEGIN TARGET GUIDE -----
{guide}
----- END TARGET GUIDE -----

Strict output rules:
- Reply with exactly ONE ```c fenced code block.
- The block contains exactly the requested function definition. No extras.
- Do NOT include any headers (no `#include`). The build system already
  prepends `<stddef.h>`, `<float.h>`, `<stdint.h>`, `<math.h>` for every
  backend, plus any target-specific headers (e.g. `<riscv_vector.h>` for
  the rvv target). `size_t`, `FLT_MAX`, fixed-width int types, `expf`,
  and target intrinsics are in scope without action on your part.
- Do NOT declare the function `static` or `inline`.
- Do NOT write a main(), helper functions, typedefs, macros, or globals.
- Use `float` (not double).
- Match the requested signature byte-for-byte (parameter names too).
"""


def _optimize_system_prompt(backend: Backend, guide: str) -> str:
    return f"""\
You are a senior C99 programmer specializing in fast numerical kernels for
embedded RISC-V (rv64imafdc) running under Zephyr, targeting the **{backend.name}**
HW backend ({backend.description}). You are given a working kernel and must
produce a faster equivalent for this target.

The optimized kernel will be:
- compiled with -O2 by riscv64-zephyr-elf-gcc
- linked into a Zephyr application and run on a spike RISC-V simulator
- profiled via rdcycle (mcycle CSR), reading the actual cycle count
- validated against a reference implementation at multiple shapes
  (atol=1e-4, rtol=1e-3)

If verification fails OR the new cycle count is not lower than the baseline,
your output is discarded. Aim for clear, correct, measurably faster code.

The guide below describes optimization techniques applicable to this target.
Stay within it.

----- BEGIN TARGET GUIDE -----
{guide}
----- END TARGET GUIDE -----

Strict output rules:
- Reply with exactly ONE ```c fenced code block.
- Output exactly the requested function definition. No extras.
- Do NOT include any headers (no `#include`). The build system already
  prepends `<stddef.h>`, `<float.h>`, `<stdint.h>`, `<math.h>` for every
  backend, plus any target-specific headers (e.g. `<riscv_vector.h>` for
  the rvv target). `size_t`, `FLT_MAX`, fixed-width int types, `expf`,
  and target intrinsics are in scope without action on your part.
- Do NOT declare the function `static` or `inline`.
- Do NOT write a main(), helper functions, typedefs, macros, or globals.
- Use `float` (not double).
- Match the requested signature byte-for-byte (parameter names too).
"""


def _correctness_user_prompt(spec: KernelSpec, shapes: list[dict],
                             algorithm) -> str:
    """Correctness prompt using a specific algorithm seed.

    `algorithm` is an AlgorithmCandidate from spec.algorithms — its
    description and reference_impl tell the LLM what *style* of
    implementation to produce. The verify oracle stays
    spec.reference_impl (algorithm-agnostic) so any equivalent kernel
    passes.
    """
    shapes_lines = "\n".join(f"  - {s}" for s in shapes)
    return f"""\
Implement this kernel:

    {spec.signature};

Semantics:
{spec.semantics}

You are implementing this op using the **{algorithm.name}** algorithm.

Algorithm description:
{algorithm.description}

Here is a correct implementation in this algorithmic style:

```c
{algorithm.reference_impl.rstrip()}
```

CRITICAL — preserve the algorithmic structure. Your job is NOT to substitute
a different, equivalent algorithm. If the reference allocates an
intermediate buffer and fills it before computing the output, your kernel
MUST also allocate and fill that buffer first (then compute). If the
reference has multiple sequential stages (e.g. gather, then matmul), your
kernel MUST keep them as separate stages — don't fuse them into a single
loop nest, even if that would produce equivalent output. The optimization
phase will allow restructuring; this correctness phase only allows
**within-stage** transforms (vectorizing a loop, swapping intrinsics, etc.).
Producing a different algorithm here, even if numerically correct, defeats
the purpose of the algorithm-database design.

Shapes your kernel will be tested at (it must be correct for all of these):
{shapes_lines}

This is the CORRECTNESS phase. Aim for the simplest, most obviously-correct
implementation in the {algorithm.name} algorithmic style that compiles and
matches the verify oracle numerically. There is a separate, later
optimization phase where you'll be asked to produce a faster equivalent.
Loop unrolling, multi-accumulator patterns, tiling, and similar transforms
belong in that later phase — they introduce tail-loop and indexing edge
cases that are easy to get wrong on the first pass. Get correct first.

Remember: ONE ```c block, only the function definition, no extras.
"""


def _retry_prompt(prev_code: str, diagnostic: str) -> str:
    return f"""\
Your previous attempt failed verification. The diagnostic was:

{diagnostic}

Your previous code:

```c
{prev_code}
```

Produce a corrected implementation. Same output rules: one ```c block, only
the function definition, no headers or extras.
"""


def _optimize_user_prompt(
    spec: KernelSpec, shapes: list[dict], baseline_code: str,
    baseline_cycles: int, parent_history: list[tuple[str, int]],
) -> str:
    shapes_lines = "\n".join(f"  - {s}" for s in shapes)
    history_block = ""
    if parent_history:
        history_block = "Earlier attempts you have already made (do not repeat them):\n\n"
        for i, (code, cyc) in enumerate(parent_history, 1):
            history_block += f"Attempt {i} ({cyc} cycles):\n```c\n{code.rstrip()}\n```\n\n"
    return f"""\
Optimize this kernel:

    {spec.signature};

Semantics:
{spec.semantics}

It must remain numerically equivalent to the reference at these test shapes:
{shapes_lines}

Current implementation ({baseline_cycles} cycles total across the model):

```c
{baseline_code.rstrip()}
```

{history_block}\
Produce a faster equivalent. Output the function definition only, in one
```c block.
"""


# ---------------------------------------------------------------------------
# File emit
# ---------------------------------------------------------------------------

def _kernel_mangled_name(op: str, model_name: Optional[str]) -> str:
    """Mangled kernel function name. Cache files stay unmangled (`kernel_op`)
    so they're reusable across models; mangling happens at emit time so two
    models' kernels.c can link side-by-side without collisions."""
    if model_name is None:
        return f"kernel_{op}"
    # _c_ident is in generate_skeleton; import lazily to avoid a hard dep loop.
    from modelblaster.pipeline.generate_skeleton import _c_ident
    return f"kernel_{op}_{_c_ident(model_name)}"


def _mangle_kernel_in_text(text: str, op: str, model_name: Optional[str]) -> str:
    """Rename every `kernel_<op>` token to `kernel_<op>_<mid>` in `text`.

    Conservative: matches the bare identifier `kernel_<op>` followed by either
    `(` (call/definition site) or whitespace/`;`/`,` (declaration). Doesn't
    touch identifiers that just have `kernel_<op>` as a prefix
    (e.g. `kernel_linear_s8` is unchanged when op=`linear`).
    """
    if model_name is None:
        return text
    import re
    new_name = _kernel_mangled_name(op, model_name)
    pattern = re.compile(rf"\bkernel_{re.escape(op)}\b")
    return pattern.sub(new_name, text)


def emit_kernels_h(specs: list[KernelSpec], out_dir: str,
                   model_name: Optional[str] = None) -> None:
    lines = [HEADER, "#pragma once", "", '#ifdef __cplusplus',
             'extern "C" {', "#endif", ""]
    for spec in specs:
        sig = _mangle_kernel_in_text(spec.signature, spec.op, model_name)
        lines.append(f"{sig};")
    lines += ["", "#ifdef __cplusplus", "}", "#endif", ""]
    with open(os.path.join(out_dir, "kernels.h"), "w") as f:
        f.write("\n".join(lines))


_BASE_KERNEL_INCLUDES = ("<stddef.h>", "<float.h>", "<stdint.h>", "<math.h>")


def emit_kernels_c(
    impls: dict[str, str], source_label: str, out_dir: str,
    backend: Optional[Backend] = None,
    model_name: Optional[str] = None,
) -> None:
    parts = [HEADER, f"/* source: {source_label} */"]
    # Universal headers (FLT_MAX/INT64_MAX/size_t are kernel-friendly and free).
    for inc in _BASE_KERNEL_INCLUDES:
        parts.append(f"#include {inc}")
    if backend is not None:
        parts.append(f"/* target: {backend.name} */")
        for inc in backend.kernel_includes:
            parts.append(f"#include {inc}")
    parts += ['#include "kernels.h"', ""]
    for op in sorted(impls):
        body = _mangle_kernel_in_text(impls[op], op, model_name)
        parts.append(body.rstrip())
        parts.append("")
    with open(os.path.join(out_dir, "kernels.c"), "w") as f:
        f.write("\n".join(parts))


# ---------------------------------------------------------------------------
# Per-backend op skip lists for the LLM optimize loop AND the initial
# BACKEND=llm kernel-gen pass.
#
# Ops listed here are KEPT at their reference/curated impl when running with
# BACKEND=llm + OPTIMIZE=1; we don't ask Sonnet to (re)write them. The motive
# for each entry is empirical: a measured Arm B-bedrock matrix capture where
# the LLM tripped verify on every attempt for that (target, op) pair while
# the curated/reference impl was already correct. See
# benchmarks/reports/baseline-dronet-arm-b-matrix-2026-05-26/methodology.md
# for the gemmini maxpool / relu / etc. failure traces.
#
# Keyed by target name (the str), not the Backend object. Lookup with
# .get(backend.name, set()).
LLM_SKIP_OPS_PER_TARGET: dict[str, set[str]] = {
    # Gemmini doesn't accelerate elementwise / pooling / activation ops
    # natively. The curated path routes maxpool through tiled_conv_dw_auto
    # + mvout pool, but LLM attempts to rewrite as a "Gemmini matmul"
    # consistently trip verify (max_abs_err=12..56 across attempts). For
    # the other ops gemmini RoCC has no special instruction so the LLM
    # has nothing to win against the scalar reference; let it fall
    # through to reference_impl rather than burning budget on retries.
    "gemmini":     {"maxpool2d_s8", "relu_s8", "batchnorm2d_s8",
                    "add_s8", "sigmoid_s8"},
    "gemmini_q31": {"maxpool2d_s8", "relu_s8", "batchnorm2d_s8",
                    "add_s8", "sigmoid_s8"},
    # Plain rvv: the elementwise / normalization ops have no working
    # curated kernel (add_s8 has none at all; batchnorm2d_s8 / cat*_c1_s8
    # exist but trip verify with linf=82 / rel_err=5.1e+13 on yolov8n
    # smoke shapes, suggesting an OOB / scale-mismatch bug in those
    # files). Arm A transparently falls back to reference for them;
    # Arm B's LLM attempts trip verify on every retry. Skip these ops
    # so the seed reference_impl holds, same as the gemmini pattern.
    # conv2d_s8 was previously here too -- that workaround was for the
    # IHWOC layout permutation bug (fixed in
    # generate_skeleton.py:_LAYOUT_PERMUTATION); conv2d now works
    # bit-exact via rvv_vsmul_vnclip and gives ~16-17× speedup.
    "rvv":         {"add_s8", "batchnorm2d_s8", "sigmoid_s8",
                    "cat2_c1_s8", "cat3_c1_s8", "cat4_c1_s8"},
}


# ---------------------------------------------------------------------------
# Verify routing — backend dictates host_ctypes vs spike_harness
# ---------------------------------------------------------------------------

def _check_signature(candidate: str, spec: KernelSpec) -> Optional[str]:
    """Cheap lexical check that the candidate contains the expected function
    signature (whitespace-insensitive, parameter names included). Searches
    anywhere in the file so curated kernels with leading /* comments */ still
    pass. Catches LLM mistakes like reordering ints before we burn a Zephyr
    build / spike run on it.
    """
    cand_norm = " ".join(candidate.split())
    sig_norm = " ".join(spec.signature.split())
    if (
        (sig_norm + " {") in cand_norm
        or (sig_norm + "{") in cand_norm
    ):
        return None
    return (
        f"signature mismatch (parameter names/order must match the declaration "
        f"in kernels.h byte-for-byte).\n"
        f"  expected: {sig_norm}\n"
        f"  got:      {cand_norm[: len(sig_norm) + 16]}..."
    )


# Lexical structural checks per algorithm. Kept lightweight: a substring
# search for an identifier we expect to see if Llama actually followed the
# algorithmic structure. False negatives (different naming) drop into the
# slow verify path which still works; the goal is just to fail FAST when
# Llama is obviously not following the algorithm.
_ALGORITHM_REQUIRED_SUBSTRINGS: dict[str, tuple[str, ...]] = {
    # im2col_gemm: must allocate and populate the im2col buffer.
    "im2col_gemm": ("im2col_buf",),
    # oc_blocked: must have an outer OC tile loop. Looking for the
    # `oc_outer` identifier from the seed example is enough to catch the
    # most common LLM mistake (collapsing the outer-OC loop and writing
    # the direct algorithm under the cache-blocked label).
    "oc_blocked": ("oc_outer", "TILE_OC"),
    # gemmini_tiled_conv: must call into the gemmini library's tiled
    # conv path. Without this gate the LLM tends to fall back to plain
    # scalar (which trivially "verifies" because it matches the
    # reference impl bit-for-bit) — defeating the whole point of the
    # algorithm seed.
    "gemmini_tiled_conv": ("tiled_conv_auto",),
    # gemmini_im2col_full_C: im2col + tiled_matmul_auto(full_C=true) +
    # scalar Q0.31 requantize. Must call tiled_matmul_auto (not
    # tiled_conv_auto) to get raw int32 accumulators.
    "gemmini_im2col_full_C": ("tiled_matmul_auto",),
    # gemmini_tiled_matmul: linear_s8 routed through tiled_matmul_auto
    # with full_C=true (raw int32 accumulator) + scalar Q0.31 requantize
    # on CPU. Same precision contract as gemmini_im2col_full_C.
    "gemmini_tiled_matmul": ("tiled_matmul_auto",),
    # gemmini_resadd: add_s8 routed through tiled_resadd_auto. Required
    # to actually call into the gemmini library — without this gate the
    # LLM would just regenerate the scalar reference under this name.
    "gemmini_resadd": ("tiled_resadd_auto",),
    # gemmini_resadd_relu: relu_s8 implemented via tiled_resadd_auto
    # with B=zeros + relu=true (no actual addition; only the
    # requantize-with-relu tail does work).
    "gemmini_resadd_relu": ("tiled_resadd_auto",),
    # gemmini_tiled_conv_pool: maxpool2d_s8 implemented via a
    # tiled_conv variant (we use tiled_conv_dw_auto) with kernel_dim=1
    # + per-channel identity weights and pool_size at the mvout pool
    # tail. The depthwise variant avoids the C×C identity weight
    # matrix the full conv would need (matters for yolov8, C=256).
    # Both `tiled_conv_auto` and `tiled_conv_dw_auto` contain the
    # `tiled_conv` substring; bit-exact verify ensures the body
    # actually does maxpool semantics.
    "gemmini_tiled_conv_pool": ("tiled_conv",),
}


def _check_algorithm_structure(candidate: str, algorithm_name: Optional[str]
                               ) -> Optional[str]:
    if algorithm_name is None:
        return None
    required = _ALGORITHM_REQUIRED_SUBSTRINGS.get(algorithm_name)
    if not required:
        return None
    cand_norm = candidate
    missing = [s for s in required if s not in cand_norm]
    if missing:
        return (
            f"algorithm '{algorithm_name}' structural check failed — "
            f"candidate is missing required identifier(s) {missing}. "
            f"This usually means the kernel fused the stages or "
            f"substituted a different algorithm. Re-read the algorithm "
            f"description and produce code that uses the named "
            f"intermediate buffer."
        )
    return None


def _verify(
    spec: KernelSpec, candidate: str, shapes: list[dict],
    *, backend: Backend,
    impls: Optional[dict[str, str]] = None,
    specs: Optional[list[KernelSpec]] = None,
    repo_root: Optional[str] = None,
    model_dir: Optional[str] = None,
    build_dir: Optional[str] = None,
    harness_dir: Optional[str] = None,
    io_path: Optional[str] = None,
    algorithm_name: Optional[str] = None,
    accuracy_class: Optional[AccuracyClass] = None,
    enforce_class_atol: bool = False,
) -> VerifyResult:
    sig_err = _check_signature(candidate, spec)
    if sig_err is not None:
        return VerifyResult(False, sig_err)
    struct_err = _check_algorithm_structure(candidate, algorithm_name)
    if struct_err is not None:
        return VerifyResult(False, struct_err)

    if backend.verify_method == VERIFY_HOST_CTYPES:
        return host_verify(spec, candidate, shapes)

    if backend.verify_method == VERIFY_SPIKE_HARNESS:
        # Build the full harness with this candidate substituted, run on
        # spike, and require the model output to match the PyTorch golden
        # within tolerance. This is necessarily coarser than per-shape
        # ctypes verify, but it's the only correctness check available for
        # backends with target-only intrinsics.
        if not all([impls is not None, specs is not None, repo_root,
                    model_dir, build_dir, harness_dir, io_path]):
            return VerifyResult(
                False,
                "spike-harness verify requires impls/specs/paths/io to be wired in",
            )
        from modelblaster.pipeline.profile_kernel import build_and_run, ProfileError
        import math as _math
        # Accumulation error scales with sqrt(K); scale atol so large-N
        # matmul/reduction kernels aren't falsely rejected for expected
        # fp32/fp16 rounding that is within float precision.
        _max_k = max(
            (s.get("K", s.get("k", 1)) for s in shapes),
            default=1,
        )
        import numpy as _np_tmp
        _io_arr = _np_tmp.load(io_path)["output"]
        _is_fp16 = _io_arr.dtype == _np_tmp.float16
        del _io_arr, _np_tmp
        if _is_fp16:
            _atol = max(1e-2, 1e-3 * _math.sqrt(_max_k))
        else:
            _atol = max(1e-5, 1e-4 * _math.sqrt(_max_k))
        # Per-backend tolerance overrides win over the dtype-derived
        # default. Used by gemmini's float-scale requantize path —
        # ~3 int8 LSBs of drift vs the Q0.31 PyTorch golden.
        _rtol_override = getattr(backend, "rtol_override", None)
        if backend.atol_override is not None:
            _atol = backend.atol_override
        # Per-algorithm accuracy class TIGHTENS the atol, never loosens it.
        # Used by --max-accuracy-class so a bit_exact claim is checked at
        # atol=0 even on a backend that nominally tolerates atol=8. The
        # caller explicitly opts in via `enforce_class_atol=True` because
        # the verify also runs the full model graph — chain drift from
        # *other* ops (e.g. a NUMERIC_DRIFT conv2d) would falsely fail an
        # otherwise-fine BIT_EXACT linear's verify in default mode.
        if enforce_class_atol and accuracy_class is not None:
            class_atol = ACCURACY_CLASS_ATOL.get(accuracy_class)
            if class_atol is not None and class_atol < _atol:
                _atol = class_atol
        trial = dict(impls)  # type: ignore[arg-type]
        trial[spec.op] = candidate
        try:
            res = build_and_run(
                trial, specs,  # type: ignore[arg-type]
                backend=backend, model_dir=model_dir,  # type: ignore[arg-type]
                build_dir=build_dir,  # type: ignore[arg-type]
                repo_root=repo_root,  # type: ignore[arg-type]
                harness_dir=harness_dir,  # type: ignore[arg-type]
                pristine=False, io_path=io_path,
                timeout=_verify_timeout(),
                atol=_atol, rtol=_rtol_override,
            )
        except ProfileError as e:
            return VerifyResult(False, f"spike-harness build/run failed:\n{e}")
        if res.golden_ok is False:
            # Decode where the divergence happened so the LLM has something
            # actionable to fix on retry.
            import numpy as _np
            golden = _np.load(io_path)["output"].astype(_np.float32).reshape(-1)  # type: ignore[arg-type]
            actual = res.output.astype(_np.float32) if res.output is not None else None
            extra = ""
            if actual is not None and actual.shape == golden.shape:
                abs_err = _np.abs(actual - golden)
                first = int(_np.argmax(abs_err > 0.0))
                ws = max(0, first - 2)
                we = min(len(golden), first + 6)
                extra = (
                    f"\n  first divergence at output flat_idx={first}\n"
                    f"  output[{ws}:{we}] expected: "
                    f"{[round(float(v), 6) for v in golden[ws:we]]}\n"
                    f"  output[{ws}:{we}] got:      "
                    f"{[round(float(v), 6) for v in actual[ws:we]]}"
                )
            return VerifyResult(
                False,
                f"model output diverged from golden (max_abs_err="
                f"{res.golden_max_abs_err:.3g}, max_rel_err="
                f"{res.golden_max_rel_err:.3g}){extra}",
                max_abs_err=res.golden_max_abs_err,
                max_rel_err=res.golden_max_rel_err,
            )
        return VerifyResult(
            True,
            f"spike-harness ok (max_abs_err={res.golden_max_abs_err:.3g} "
            f"max_rel_err={res.golden_max_rel_err:.3g}, "
            f"cycles={res.cycles_by_op})",
            max_abs_err=res.golden_max_abs_err,
            max_rel_err=res.golden_max_rel_err,
            cycles_by_op=dict(res.cycles_by_op) if res.cycles_by_op else None,
        )

    return VerifyResult(False, f"unknown verify_method {backend.verify_method}")


# ---------------------------------------------------------------------------
# Correctness loop
# ---------------------------------------------------------------------------

def _generate_one_llm_for_algorithm(
    spec: KernelSpec,
    algorithm,  # AlgorithmCandidate
    shapes: list[dict],
    client: LLMClient,
    backend: Backend,
    correctness_system: str,
    max_retries: int,
    log,
    *,
    impls: dict[str, str],
    specs: list[KernelSpec],
    repo_root: Optional[str],
    model_dir: Optional[str],
    build_dir: Optional[str],
    harness_dir: Optional[str],
    io_path: Optional[str],
    cache_dir: Optional[str] = None,
) -> Optional[str]:
    """Try to drive Bedrock to produce a kernel implementing `algorithm`
    for this spec. Returns C source on success, None on giving up.
    """
    # Cache hit: if we have a previously-verified kernel for this
    # (op, target, algorithm) triple, reverify it and skip the LLM if it
    # still passes. Cache key is per-algorithm so different algos don't
    # clobber each other.
    cache_path = (
        os.path.join(cache_dir, f"{backend.name}_{spec.op}_{algorithm.name}.c")
        if cache_dir else None
    )
    if cache_path and os.path.exists(cache_path):
        cached = open(cache_path).read()
        log(f"  [{spec.op}/{algorithm.name}] trying cached kernel from {cache_path}")
        vres = _verify(
            spec, cached, shapes, backend=backend,
            impls=impls, specs=specs,
            repo_root=repo_root, model_dir=model_dir,
            build_dir=build_dir, harness_dir=harness_dir, io_path=io_path,
            algorithm_name=algorithm.name,
        )
        if vres.ok:
            log(f"  [{spec.op}/{algorithm.name}] cache HIT — {vres.message}")
            return cached
        log(f"  [{spec.op}/{algorithm.name}] cache stale "
            f"({vres.message.splitlines()[0]}); regenerating")

    prev_code: Optional[str] = None
    prev_diag: Optional[str] = None
    for attempt in range(1, max_retries + 1):
        if prev_code is None:
            user = _correctness_user_prompt(spec, shapes, algorithm)
        else:
            user = _retry_prompt(prev_code, prev_diag or "(no diagnostic)")
        log(f"  [{spec.op}/{algorithm.name}] attempt {attempt}/{max_retries}: "
            f"calling {client.model_id}")
        temp = 0.0 if attempt == 1 else 0.3
        # 32k tokens is well within Sonnet 4.6's output budget and gives
        # plenty of headroom for unrolled / cache-aware kernels. Earlier
        # 2048 cap got hit on sigmoid_f16 / conv2d_f16 mid-expression and
        # produced unparseable truncations.
        res = client.converse(user=user, system=correctness_system,
                              max_tokens=32768, temperature=temp,
                              phase=f"synth:{spec.op}")
        log(f"  [{spec.op}/{algorithm.name}] tokens "
            f"in={res.input_tokens} out={res.output_tokens} "
            f"stop={res.stop_reason}")
        candidate = extract_code_block(res.text, lang="c")
        vres = _verify(
            spec, candidate, shapes, backend=backend,
            impls=impls, specs=specs,
            repo_root=repo_root, model_dir=model_dir,
            build_dir=build_dir, harness_dir=harness_dir, io_path=io_path,
            algorithm_name=algorithm.name,
        )
        if vres.ok:
            log(f"  [{spec.op}/{algorithm.name}] verify PASS — {vres.message}")
            if cache_path:
                os.makedirs(os.path.dirname(cache_path), exist_ok=True)
                with open(cache_path, "w") as f:
                    f.write(candidate)
                log(f"  [{spec.op}/{algorithm.name}] cached -> {cache_path}")
            return candidate
        # Print the first line of the diagnostic on the verify-FAIL line,
        # then dump the full message at low verbosity. Knowing exactly
        # which compile error / golden mismatch fired is essential when
        # the LLM keeps regenerating the same broken pattern.
        first_line = vres.message.splitlines()[0] if vres.message.strip() \
            else "(no diagnostic returned)"
        log(f"  [{spec.op}/{algorithm.name}] verify FAIL — {first_line}")
        if vres.message.strip() and len(vres.message.splitlines()) > 1:
            for line in vres.message.splitlines()[1:]:
                log(f"      {line}")
        prev_code = candidate
        prev_diag = vres.message
    log(f"  [{spec.op}/{algorithm.name}] gave up after {max_retries} attempts")
    return None


def generate_one_llm(
    spec: KernelSpec,
    shapes: list[dict],
    client: LLMClient,
    backend: Backend,
    correctness_system: str,
    max_retries: int,
    log,
    *,
    impls: dict[str, str],
    specs: list[KernelSpec],
    repo_root: Optional[str],
    model_dir: Optional[str],
    build_dir: Optional[str],
    harness_dir: Optional[str],
    io_path: Optional[str],
    cache_dir: Optional[str] = None,
    algorithm_filter: Optional[set[str]] = None,
    global_curated_dir: Optional[str] = None,
    max_accuracy_class: Optional[AccuracyClass] = None,
) -> Optional[tuple[str, str]]:
    """Try each algorithm in spec.algorithms in order. First one that
    produces a passing kernel wins. Returns ``(code, algorithm_name)`` so
    callers can track which algorithm was selected (e.g. to write the
    optimized variant back to the right cache file).
    `algorithm_filter` (if set) restricts
    to a subset of algorithm names — but if NO algorithms on this spec
    match the filter (e.g. user asked for 'im2col_gemm' but `linear` only
    has 'direct'), fall back to the spec's full algorithm list rather than
    failing the run. The filter is best-thought-of as "prefer these where
    available", not "only these everywhere".

    `global_curated_dir` (if set) is a root directory of hand-curated generic
    kernels laid out as ``<global_curated_dir>/<target>/<backend>_<op>_<algo>.c``.
    These are checked BEFORE the per-model cache, and on a hit+pass the file is
    promoted into the per-model cache so future runs skip the verify. Curated
    kernels participate in the same fastest-wins competition as cached ones —
    if both a curated and a previously-cached kernel exist for the same op, the
    faster one is used.
    """
    if algorithm_filter is None:
        candidates = list(spec.algorithms)
    else:
        candidates = [a for a in spec.algorithms if a.name in algorithm_filter]
        if not candidates:
            log(f"  [{spec.op}] filter {sorted(algorithm_filter)} matches "
                f"none of this op's algorithms "
                f"{[a.name for a in spec.algorithms]}; falling back to all")
            candidates = list(spec.algorithms)
    # Also drop algorithms whose target_affinity excludes this backend.
    candidates = [
        a for a in candidates
        if not a.target_affinity or backend.name in a.target_affinity
    ]
    if not candidates:
        log(f"  [{spec.op}] no algorithms remain after target_affinity "
            f"filter for target {backend.name}")
        return None

    # Target-affinity preference: when the spec has at least one
    # algorithm explicitly affined to this backend (e.g. an RVV-curated
    # variant alongside the universal scalar `direct`), drop the
    # universal-affinity entries from the queue. The whole point of the
    # curated kernel is to use it on its target — picking scalar
    # `direct` over RVV-affined `rvv_vsmul_vnclip` because spike's
    # flat-memory model + baked-in default VLEN under-shows the RVV
    # benefit defeats the purpose of curating.
    #
    # spike's `--isa=rv64gcv_zicntr` runs with VLEN baked at build
    # time (no `--varch` support in this build), so the cycle-rank
    # comparison between vector and scalar candidates is systematically
    # biased on tiny shapes (yolov8 5x5 OC=64 with vlmax=16 spends a
    # high fraction of cycles in vsetvl/broadcast). Bias the algorithm
    # selection toward target-affined kernels and let real-HW (FireSim)
    # rank them when re-rank is enabled.
    has_target_affined = any(
        a.target_affinity and backend.name in a.target_affinity
        for a in candidates
    )
    if has_target_affined:
        before = [a.name for a in candidates]
        candidates = [
            a for a in candidates
            if a.target_affinity and backend.name in a.target_affinity
        ]
        dropped = [n for n in before if n not in (a.name for a in candidates)]
        if dropped:
            log(f"  [{spec.op}] target-affinity preference: dropped "
                f"universal-affinity {dropped} in favor of "
                f"{[a.name for a in candidates]}")
    # Filter on accuracy class if --max-accuracy-class restricts it. We
    # NEVER fall back when this filter empties the queue — the whole point
    # of the flag is to refuse to ship a looser kernel than the user asked
    # for. Caller is expected to surface the empty-queue case as a hard error.
    if max_accuracy_class is not None:
        before = [a.name for a in candidates]
        candidates = [
            a for a in candidates if a.accuracy_class <= max_accuracy_class
        ]
        if not candidates:
            log(f"  [{spec.op}] no algorithms at-or-tighter-than "
                f"{max_accuracy_class.name.lower()} (had {before})")
            return None
    log(f"  [{spec.op}] algorithm queue: "
        f"{[a.name for a in candidates]}")

    # First pass: probe available kernels across ALL candidate algorithms and
    # pick the fastest. Two sources are probed, in priority order per algorithm:
    #   1. Global curated dir (hand-written / out-of-pipeline kernels).
    #      Layout: <global_curated_dir>/<target>/<backend>_<op>_<algo>.c
    #      On hit+pass the file is promoted into the per-model cache so
    #      subsequent runs skip the verify step.
    #   2. Per-model LLM cache (<cache_dir>/<backend>_<op>_<algo>.c).
    # All valid candidates — curated or cached — enter the same
    # fastest-wins competition so the pipeline always picks the best
    # available kernel regardless of where it came from.
    if cache_dir is not None or global_curated_dir is not None:
        best_cached_code: Optional[str] = None
        best_cached_algo: Optional[str] = None
        best_cached_cycles: Optional[int] = None
        for algorithm in candidates:
            filename = f"{backend.name}_{spec.op}_{algorithm.name}.c"
            per_model_cache_path = (
                os.path.join(cache_dir, filename) if cache_dir else None
            )

            # --- curated probe (subset: only algorithms that have a file) ---
            curated_path = (
                os.path.join(global_curated_dir, backend.name, filename)
                if global_curated_dir else None
            )
            if curated_path and os.path.exists(curated_path):
                curated = open(curated_path).read()
                # If the curated header declares a stricter class than the
                # spec's algorithm metadata, that wins (the file is an
                # implementation of the algorithm and may have been
                # sharpened beyond the algorithm's loose default). If it
                # declares a looser class, that wins too — be honest about
                # what this specific implementation guarantees.
                curated_class = _parse_curated_accuracy_class(curated) \
                    or algorithm.accuracy_class
                if (max_accuracy_class is not None
                        and curated_class > max_accuracy_class):
                    log(f"  [{spec.op}/{algorithm.name}] curated kernel "
                        f"declares accuracy_class={curated_class.name.lower()} "
                        f">{max_accuracy_class.name.lower()}; skipping")
                    continue
                log(f"  [{spec.op}/{algorithm.name}] probing curated kernel "
                    f"from {curated_path}")
                vres = _verify(
                    spec, curated, shapes, backend=backend,
                    impls=impls, specs=specs,
                    repo_root=repo_root, model_dir=model_dir,
                    build_dir=build_dir, harness_dir=harness_dir,
                    io_path=io_path, algorithm_name=algorithm.name,
                    accuracy_class=curated_class,
                    enforce_class_atol=(max_accuracy_class is not None),
                )
                if vres.ok:
                    cyc = (vres.cycles_by_op or {}).get(spec.op)
                    log(f"  [{spec.op}/{algorithm.name}] curated HIT — "
                        f"{cyc if cyc is not None else '?'} cycles")
                    # Promote to per-model cache so future runs skip verify.
                    if per_model_cache_path:
                        os.makedirs(os.path.dirname(per_model_cache_path),
                                    exist_ok=True)
                        shutil.copy(curated_path, per_model_cache_path)
                        log(f"  [{spec.op}/{algorithm.name}] promoted curated "
                            f"-> {per_model_cache_path}")
                    if best_cached_cycles is None or (
                            cyc is not None and cyc < best_cached_cycles):
                        best_cached_code = curated
                        best_cached_algo = algorithm.name
                        best_cached_cycles = cyc
                    continue  # curated found; skip per-model cache for this algo
                else:
                    log(f"  [{spec.op}/{algorithm.name}] curated MISS "
                        f"({vres.message.splitlines()[0]})")

            # --- per-model cache probe ---
            if per_model_cache_path and os.path.exists(per_model_cache_path):
                cached = open(per_model_cache_path).read()
                cached_class = _parse_curated_accuracy_class(cached) \
                    or algorithm.accuracy_class
                if (max_accuracy_class is not None
                        and cached_class > max_accuracy_class):
                    log(f"  [{spec.op}/{algorithm.name}] cached kernel "
                        f"declares accuracy_class={cached_class.name.lower()} "
                        f">{max_accuracy_class.name.lower()}; skipping")
                    continue
                log(f"  [{spec.op}/{algorithm.name}] probing cached kernel")
                vres = _verify(
                    spec, cached, shapes, backend=backend,
                    impls=impls, specs=specs,
                    repo_root=repo_root, model_dir=model_dir,
                    build_dir=build_dir, harness_dir=harness_dir,
                    io_path=io_path, algorithm_name=algorithm.name,
                    accuracy_class=cached_class,
                    enforce_class_atol=(max_accuracy_class is not None),
                )
                if not vres.ok:
                    log(f"  [{spec.op}/{algorithm.name}] cache stale "
                        f"({vres.message.splitlines()[0]})")
                    continue
                cyc = (vres.cycles_by_op or {}).get(spec.op)
                log(f"  [{spec.op}/{algorithm.name}] cache HIT — "
                    f"{cyc if cyc is not None else '?'} cycles")
                if best_cached_cycles is None or (
                        cyc is not None and cyc < best_cached_cycles):
                    best_cached_code = cached
                    best_cached_algo = algorithm.name
                    best_cached_cycles = cyc

        if best_cached_code is not None:
            log(f"  [{spec.op}] using algorithm '{best_cached_algo}' "
                f"({best_cached_cycles} cycles, fastest of available options)")
            return best_cached_code, best_cached_algo

    # No cache hits — generate for each algorithm in order, take the
    # first one that verifies. (This is the original behavior; it's
    # the correct shape when there's no prior cycle data to compare.)
    for algorithm in candidates:
        code = _generate_one_llm_for_algorithm(
            spec, algorithm, shapes, client, backend, correctness_system,
            max_retries, log,
            impls=impls, specs=specs,
            repo_root=repo_root, model_dir=model_dir,
            build_dir=build_dir, harness_dir=harness_dir, io_path=io_path,
            cache_dir=cache_dir,
        )
        if code is not None:
            log(f"  [{spec.op}] using algorithm '{algorithm.name}'")
            return code, algorithm.name
    log(f"  [{spec.op}] all {len(candidates)} algorithms exhausted")
    return None


def collect_shapes(ir: dict, op: str, spec: KernelSpec) -> list[dict]:
    return shapes_from_ir(ir, op) + spec.extra_shapes


# ---------------------------------------------------------------------------
# Beam-search optimize loop
# ---------------------------------------------------------------------------

def _normalize(code: str) -> str:
    return " ".join(code.split())


def beam_search_optimize(
    spec: KernelSpec,
    shapes: list[dict],
    baseline_code: str,
    baseline_cycles: int,
    *,
    impls: dict[str, str],
    specs: list[KernelSpec],
    backend: Backend,
    client: LLMClient,
    optimize_system: str,
    repo_root: str,
    model_dir: str,
    build_dir: str,
    harness_dir: str,
    io_path: Optional[str],
    beam: int,
    expansions: int,
    iterations: int,
    log,
) -> tuple[str, int, list[dict], list[tuple[str, int]]]:
    """Returns (best_code, best_cycles, history, all_viable_proposals).

    `all_viable_proposals` is every distinct (code, spike_cycles) pair
    that survived build+verify across all iterations, sorted by
    cycles ascending. Used downstream by the firesim re-rank step
    to pick the top-K spike survivors and re-score them on real RTL.
    Note: the baseline is NOT in this list — callers should add it.
    """
    from modelblaster.pipeline.profile_kernel import build_and_run, ProfileError

    Beam = list[tuple[str, int]]
    beam_set: Beam = [(baseline_code, baseline_cycles)]
    best_code, best_cycles = baseline_code, baseline_cycles
    seen: set[str] = {_normalize(baseline_code)}
    history: list[dict] = []
    # Cumulative list of every distinct candidate that built+verified
    # successfully (across all iterations). The firesim re-rank step
    # consumes the top-K of this list to score on real RTL.
    all_viable: list[tuple[str, int]] = []

    for it in range(1, iterations + 1):
        log(f"  [{spec.op}] iter {it}/{iterations}  beam=[{', '.join(str(c) for _, c in beam_set)}]  best={best_cycles}")
        proposals: Beam = []
        for parent_idx, (parent_code, parent_cycles) in enumerate(beam_set):
            for exp in range(1, expansions + 1):
                log(f"    parent {parent_idx} ({parent_cycles} cyc) exp {exp}/{expansions}: calling LLM")
                user = _optimize_user_prompt(
                    spec, shapes, parent_code, parent_cycles,
                    parent_history=[(c, cy) for c, cy in beam_set if c != parent_code],
                )
                res = client.converse(
                    user=user, system=optimize_system,
                    max_tokens=32768, temperature=0.5,
                    phase=f"optimize:{spec.op}",
                )
                log(f"      tokens in={res.input_tokens} out={res.output_tokens}")
                # Token usage attaches to every history record produced
                # for this call, regardless of how the candidate exits
                # (duplicate / build_fail / verify_fail / ok). Lets the
                # trajectory log answer "how much did we pay per
                # successful candidate?" without re-joining JSONL logs.
                tokens_in = int(res.input_tokens or 0)
                tokens_out = int(res.output_tokens or 0)
                candidate = extract_code_block(res.text, lang="c")
                key = _normalize(candidate)
                if key in seen:
                    log(f"      duplicate, skip")
                    history.append({
                        "iter": it, "parent_idx": parent_idx,
                        "exp_idx": exp, "parent_cycles": parent_cycles,
                        "result": "duplicate",
                        "tokens_in": tokens_in, "tokens_out": tokens_out,
                    })
                    continue
                seen.add(key)

                # Combined verify + profile in one harness build.
                trial = dict(impls)
                trial[spec.op] = candidate
                try:
                    hres = build_and_run(
                        trial, specs, backend=backend,
                        model_dir=model_dir, build_dir=build_dir,
                        repo_root=repo_root, harness_dir=harness_dir,
                        pristine=False, io_path=io_path,
                        timeout=_verify_timeout(),
                    )
                except ProfileError as e:
                    # Surface the actual gcc error / spike trace so the loop
                    # operator can spot patterns. Show enough lines that the
                    # cc1 diagnostic (which lands several lines past the
                    # "west build failed" / "cmd:" / "stdout/stderr (tail):"
                    # framing) makes it through.
                    err_lines = [ln for ln in str(e).splitlines() if ln.strip()]
                    head = err_lines[:25]
                    log(f"      build/spike FAIL:")
                    for ln in head:
                        log(f"        {ln[:300]}")
                    history.append({
                        "iter": it, "parent_idx": parent_idx,
                        "exp_idx": exp, "parent_cycles": parent_cycles,
                        "result": "build_fail",
                        "tokens_in": tokens_in, "tokens_out": tokens_out,
                        "diag": " | ".join(head)[:2000],
                    })
                    continue

                if io_path and hres.golden_ok is False:
                    log(f"      verify FAIL: golden mismatch "
                        f"(max_abs_err={hres.golden_max_abs_err:.3g})")
                    history.append({
                        "iter": it, "parent_idx": parent_idx,
                        "exp_idx": exp, "parent_cycles": parent_cycles,
                        "result": "verify_fail",
                        "tokens_in": tokens_in, "tokens_out": tokens_out,
                        "diag": f"golden mismatch ({hres.golden_max_abs_err:.3g})",
                    })
                    continue

                # On host-verifiable backends, also re-run host verify with the
                # numerical sweep — catches cases where the model shapes are
                # narrow but extra_shapes are not.
                if backend.verify_method == VERIFY_HOST_CTYPES:
                    vres = host_verify(spec, candidate, shapes)
                    if not vres.ok:
                        log(f"      host verify FAIL: {vres.message.splitlines()[0]}")
                        history.append({
                            "iter": it, "parent_idx": parent_idx,
                            "exp_idx": exp, "parent_cycles": parent_cycles,
                            "result": "verify_fail",
                            "tokens_in": tokens_in, "tokens_out": tokens_out,
                            "diag": vres.message.splitlines()[0],
                        })
                        continue

                new_cycles = hres.cycles_by_op.get(spec.op, 0)
                log(f"      {parent_cycles} -> {new_cycles} cyc"
                    f" ({(parent_cycles-new_cycles)/parent_cycles*100:+.1f}%)")
                history.append({
                    "iter": it, "parent_idx": parent_idx,
                    "exp_idx": exp, "parent_cycles": parent_cycles,
                    "result": "ok", "cycles": new_cycles,
                    "tokens_in": tokens_in, "tokens_out": tokens_out,
                })
                proposals.append((candidate, new_cycles))
                all_viable.append((candidate, new_cycles))
                if new_cycles < best_cycles:
                    best_code, best_cycles = candidate, new_cycles

        if not proposals:
            log(f"  [{spec.op}] no surviving proposals this iter, stopping")
            break

        beam_set = sorted(proposals, key=lambda x: x[1])[:beam]
        if beam_set[0][1] >= best_cycles and best_cycles < baseline_cycles:
            log(f"  [{spec.op}] no further improvement, stopping early")
            break

    log(f"  [{spec.op}] BEST: {baseline_cycles} -> {best_cycles} "
        f"({(baseline_cycles - best_cycles) / baseline_cycles * 100:+.1f}%)")
    # Sort viable proposals cheapest-spike first; dedupe identical
    # bodies that may have come up across iterations.
    viable_sorted: list[tuple[str, int]] = []
    seen_norm: set[str] = set()
    for code, cyc in sorted(all_viable, key=lambda x: x[1]):
        key = _normalize(code)
        if key in seen_norm:
            continue
        seen_norm.add(key)
        viable_sorted.append((code, cyc))
    return best_code, best_cycles, history, viable_sorted


# ---------------------------------------------------------------------------
# Top-level driver
# ---------------------------------------------------------------------------

def generate(
    ir_path: str,
    out_dir: str,
    backend_name: str,
    target_name: str,
    *,
    max_retries: int = 4,
    optimize: bool = False,
    beam: int = 2,
    expansions: int = 3,
    iterations: int = 2,
    repo_root: Optional[str] = None,
    build_dir: Optional[str] = None,
    harness_dir: str = "modelblaster/harness",
    io_path: Optional[str] = None,
    cache_dir: Optional[str] = None,
    algorithm_filter: Optional[set[str]] = None,
    global_curated_dir: Optional[str] = None,
    max_accuracy_class: Optional[AccuracyClass] = None,
    quant: str = "fp32",
    # Opt-in: after the spike beam search picks a best, re-rank the
    # top-K spike survivors on FireSim RTL. The cache slot is replaced
    # with the firesim-best only if the firesim cycles drop by >=
    # FiresimEvalConfig.replacement_threshold_pct vs. the baseline. Off
    # by default — it's expensive (1-3 min per candidate FPGA build+run).
    firesim_eval: bool = False,
    firesim_top_k: int = 3,
    # Opt-in: include the memory-hierarchy stanza in the optimize-phase
    # system prompt. Only useful when firesim_eval=True (otherwise the
    # spike scorer is blind to cache wins, so the LLM has no incentive
    # to produce them).
    cache_aware_prompt: bool = False,
    firesim_op_filter: Optional[set[str]] = None,
) -> None:
    os.makedirs(out_dir, exist_ok=True)
    with open(ir_path) as f:
        ir = json.load(f)

    # The IR records the quantization mode it was extracted under; reject
    # mismatches (e.g. running an int8 IR through the fp32 codegen) loudly.
    ir_quant = ir.get("quant", "fp32")
    if quant != ir_quant:
        raise SystemExit(
            f"quant mismatch: caller passed --quant={quant} but IR was "
            f"extracted with quant={ir_quant}. Re-extract the model with "
            f"the same quant flag, or pass --quant={ir_quant}."
        )
    if quant not in ("fp32", "fp16", "int8"):
        raise SystemExit(
            f"quant={quant!r} not implemented in generate_kernels yet "
            f"(have: fp32, fp16, int8)."
        )

    target = backends_mod.get(target_name)

    # Zero-cost ops compile to buffer aliases / pointer arithmetic in the
    # skeleton and have no kernel:
    #   * `view`     — flatten / dropout in eval mode
    #   * `chunk2_c1` — channel-wise split (YOLOv8 C2f), maps to two
    #                   offset aliases into the input buffer.
    _zero_cost = {"view", "chunk2_c1", "chunk2_c1_f16", "chunk2_c1_s8"}
    op_kinds = sorted({op["op"] for op in ir["ops"] if op["op"] not in _zero_cost})
    for k in op_kinds:
        if k not in KERNEL_SPECS:
            raise SystemExit(f"unknown op kind in IR: {k}")
    specs = [KERNEL_SPECS[k] for k in op_kinds]

    log = lambda msg: print(msg, flush=True)
    impls: dict[str, str] = {}
    # Per-op tracking of which algorithm was selected during baseline gen.
    # Used by the optimize loop to write the optimized kernel back to the
    # right cache file (same key the baseline read from).
    chosen_algo: dict[str, str] = {}
    # Per-op record of where each kernel ended up coming from. Written
    # to kernel_picks.json next to kernels.c so the benchmark harness
    # can answer "Arm A: how many curated kernels matched vs scalar
    # fallback?" and "Arm B: which algorithm did the LLM pick per op?"
    # The schema is provider-agnostic and arm-agnostic:
    #   {op: {source: reference|curated|cached|llm,
    #         algorithm: str|null,
    #         path: str|null}}
    kernel_picks: dict[str, dict[str, Optional[str]]] = {}

    needs_harness_paths = (
        target.verify_method == VERIFY_SPIKE_HARNESS
        or optimize
    )
    if needs_harness_paths:
        if not (repo_root and build_dir and io_path):
            raise SystemExit(
                f"target={target.name} verify_method={target.verify_method}"
                f" or --optimize requires --repo-root, --build-dir, --io"
            )

    # Correctness phase.
    if backend_name == "reference":
        log(f"backend=reference  target={target.name}  ops={op_kinds}")
        for spec in specs:
            impls[spec.op] = spec.reference_impl
            kernel_picks[spec.op] = {
                "source": "reference", "algorithm": None, "path": None,
            }
        # Also probe the global curated dir under the reference path so
        # hand-written curated kernels can be exercised without needing
        # LLM credentials. For each spec, look up any algorithm whose file
        # exists at <global_curated_dir>/<target>/<backend>_<op>_<algo>.c
        # and swap in the curated source instead of the scalar reference.
        # First-found-wins (algorithms are queue-ordered by target_affinity
        # in spec.algorithms).
        #
        # Per-kernel verification: when MODELBLASTER_CURATED_VERIFY=1 (the
        # default) and the surrounding harness is wired (build_dir / repo_root
        # / harness_dir / io_path present), we call _verify on each curated
        # source against the spec's extra_shapes BEFORE accepting the swap.
        # If verify fails, fall back to spec.reference_impl with a warning
        # so the e2e build proceeds. Set MODELBLASTER_CURATED_VERIFY=0 to
        # skip (one extra spike build per curated kernel takes ~10-30s).
        curated_verify = (
            os.environ.get("MODELBLASTER_CURATED_VERIFY", "1") == "1"
            and needs_harness_paths
        )
        if global_curated_dir is not None:
            for spec in specs:
                for algorithm in spec.algorithms:
                    filename = (
                        f"{target.name}_{spec.op}_{algorithm.name}.c"
                    )
                    curated_path = os.path.join(
                        global_curated_dir, target.name, filename
                    )
                    if not os.path.exists(curated_path):
                        continue
                    curated_src = open(curated_path).read()
                    log(f"  [{spec.op}/{algorithm.name}] reference + "
                        f"curated swap from {curated_path}")
                    accepted = True
                    if curated_verify:
                        shapes = collect_shapes(ir, spec.op, spec)
                        log(f"  [{spec.op}/{algorithm.name}] verify curated "
                            f"at {len(shapes)} shape(s) vs reference_impl")
                        try:
                            vres = _verify(
                                spec, curated_src, shapes,
                                backend=target, impls=impls, specs=specs,
                                repo_root=repo_root, model_dir=out_dir,
                                build_dir=build_dir,
                                harness_dir=harness_dir, io_path=io_path,
                                algorithm_name=algorithm.name,
                            )
                        except Exception as e:
                            log(f"  [{spec.op}/{algorithm.name}] curated "
                                f"verify raised {type(e).__name__}: {e}; "
                                f"falling back to reference_impl")
                            accepted = False
                            vres = None
                        if vres is not None and not vres.ok:
                            log(f"  [{spec.op}/{algorithm.name}] curated "
                                f"verify FAIL — {vres.message}; "
                                f"falling back to reference_impl")
                            accepted = False
                        elif vres is not None:
                            log(f"  [{spec.op}/{algorithm.name}] curated "
                                f"verify PASS — {vres.message}")
                    if accepted:
                        impls[spec.op] = curated_src
                        kernel_picks[spec.op] = {
                            "source": "curated",
                            "algorithm": algorithm.name,
                            "path": curated_path,
                        }
                        break  # first-accepted-wins; try next spec
                    # If verify failed, continue to next algorithm; if
                    # all algorithms fail, kernel_picks keeps the original
                    # "reference" entry and impls keeps reference_impl.
    elif backend_name == "llm":
        # Lazy proxy: the LLM client is only instantiated when actually needed
        # for LLM inference. Curated/cached kernel hits skip LLM entirely, so
        # runs that hit all curated kernels don't require AWS credentials.
        class _LazyClient:
            def __init__(self_):
                object.__setattr__(self_, '_real', None)
            def __getattr__(self_, name):
                real = object.__getattribute__(self_, '_real')
                if real is None:
                    real = make_llm_client()
                    object.__setattr__(self_, '_real', real)
                return getattr(real, name)
        client = _LazyClient()
        guide = _load_backend_guide(target)
        correctness_system = _correctness_system_prompt(target, guide)
        log(f"backend=llm  target={target.name}  ops={op_kinds}")
        # Seed impls with reference so spike-harness verify has stand-ins
        # for ops not yet generated.
        for spec in specs:
            impls[spec.op] = spec.reference_impl
        # First pass: write reference + emit so the harness can build at all.
        emit_kernels_h(specs, out_dir, model_name=ir["name"])
        emit_kernels_c(impls, "seed", out_dir, backend=target, model_name=ir["name"])
        _llm_skip = LLM_SKIP_OPS_PER_TARGET.get(target.name, set())
        for spec in specs:
            if spec.op in _llm_skip:
                log(f"  [{spec.op}] target={target.name} -> "
                    f"LLM-gen skip (curated/reference is best known); "
                    f"keeping reference_impl from seed step")
                kernel_picks[spec.op] = {
                    "source": "reference",
                    "algorithm": None,
                    "path": None,
                }
                chosen_algo[spec.op] = "direct"
                continue
            shapes = collect_shapes(ir, spec.op, spec)
            log(f"  [{spec.op}] verify shapes={shapes}")
            result = generate_one_llm(
                spec, shapes, client, target, correctness_system,
                max_retries, log,
                impls=impls, specs=specs,
                repo_root=repo_root, model_dir=out_dir,
                build_dir=build_dir, harness_dir=harness_dir, io_path=io_path,
                cache_dir=cache_dir,
                algorithm_filter=algorithm_filter,
                global_curated_dir=global_curated_dir,
                max_accuracy_class=max_accuracy_class,
            )
            if result is None:
                if max_accuracy_class is not None:
                    raise SystemExit(
                        f"no algorithm at-or-tighter-than "
                        f"--max-accuracy-class={max_accuracy_class.name.lower()}"
                        f" passed verify for op '{spec.op}'. Either relax the "
                        f"flag or add a tighter-class algorithm."
                    )
                raise SystemExit(
                    f"failed to generate kernel for op '{spec.op}' "
                    f"after {max_retries} attempts"
                )
            code, chosen = result
            impls[spec.op] = code
            chosen_algo[spec.op] = chosen
            # generate_one_llm may have hit a cache / curated probe
            # internally; today we can't distinguish those cleanly
            # from a fresh LLM synthesis without further plumbing.
            # Record as "llm" (the path that reached this point through
            # the LLM backend) with the chosen algorithm name. A
            # follow-up that propagates the actual code source out of
            # generate_one_llm can refine cached/curated/llm.
            kernel_picks[spec.op] = {
                "source": "llm",
                "algorithm": chosen,
                "path": None,
            }
    else:
        raise SystemExit(f"unknown --backend: {backend_name}")

    emit_kernels_h(specs, out_dir, model_name=ir["name"])
    emit_kernels_c(impls, backend_name, out_dir, backend=target, model_name=ir["name"])
    # Emit the per-op kernel_picks alongside kernels.c. The benchmark
    # harness's arm driver copies this into the cell's run dir; the
    # aggregator's kernel_picks extractors derive per-source counts +
    # algorithm diversity.
    picks_path = os.path.join(out_dir, "kernel_picks.json")
    with open(picks_path, "w") as _f:
        json.dump({"schema_version": 1, "target": target.name,
                   "picks": kernel_picks}, _f, indent=2)
    print(f"wrote {os.path.join(out_dir, 'kernels.h')}")
    print(f"wrote {os.path.join(out_dir, 'kernels.c')}  "
          f"(source={backend_name} target={target.name})")
    print(f"wrote {picks_path}")

    if not optimize:
        return

    # Optimize phase.
    if backend_name != "llm":
        log("optimize: requires --backend llm; reference impls are not expanded.")
        return

    log("")
    log(f"optimize: beam={beam} expansions={expansions} iterations={iterations}")
    log(f"optimize: harness={harness_dir} build_dir={build_dir} target={target.name}")

    from modelblaster.pipeline.profile_kernel import build_and_run, ProfileError

    log("optimize: baseline build + profile (pristine)")
    try:
        baseline = build_and_run(
            impls, specs, backend=target,
            model_dir=out_dir, build_dir=build_dir, repo_root=repo_root,  # type: ignore[arg-type]
            harness_dir=harness_dir, pristine=True, io_path=io_path,
            timeout=_verify_timeout(),
        )
    except ProfileError as e:
        raise SystemExit(f"baseline profile failed:\n{e}")
    if io_path and baseline.golden_ok is False:
        raise SystemExit(
            f"baseline diverged from PyTorch golden "
            f"(max_abs_err={baseline.golden_max_abs_err:.3g}); refusing to optimize"
        )
    baseline_cycles_by_op = baseline.cycles_by_op
    log("optimize: baseline cycles per op kind: "
        + ", ".join(f"{k}={v}" for k, v in sorted(baseline_cycles_by_op.items())))

    guide = _load_backend_guide(target)
    optimize_system = _optimize_system_prompt(target, guide)
    # Inject the FireSim memory-hierarchy stanza into the optimize prompt
    # whenever the target has caches the LLM can reason about. The L1D /
    # LLC / DRAM numbers are intrinsic to the platform — not the eval
    # mode — so the prompt-level guidance applies regardless of whether
    # the inner-loop selector ranks on spike or FireSim. Spike won't
    # *reward* a cache-friendly rewrite (it doesn't model misses), but
    # it also won't penalize one, and FireSim re-rank (when active)
    # picks it up. `cache_aware_prompt=False` opts out for cases where
    # the user wants a strictly flat-memory prompt.
    _CACHE_AWARE_TARGETS = {"rvv", "rvv_f16", "rvv_opu", "scalar", "scalar_f16"}
    if cache_aware_prompt or target.name in _CACHE_AWARE_TARGETS:
        from modelblaster.optimize.firesim_eval import memory_model_stanza
        stanza = memory_model_stanza()
        optimize_system = optimize_system + "\n\n" + stanza
        log(f"optimize: prompt enriched with target memory-hierarchy stanza "
            f"(target={target.name})")
    client = make_llm_client()

    # Pre-instantiate the firesim evaluator (one per generate() call). It
    # reuses a separate chipyard build dir from the spike build_dir so
    # the spike beam can rebuild while a firesim run is in flight.
    firesim_evaluator = None
    if firesim_eval:
        from modelblaster.optimize.firesim_eval import (
            FiresimEvaluator, FiresimEvalConfig,
        )
        firesim_build_dir = (build_dir or "") + "_firesim_eval"
        firesim_evaluator = FiresimEvaluator(
            backend=target, impls=impls, specs=specs,
            repo_root=repo_root, model_dir=out_dir,  # type: ignore[arg-type]
            firesim_build_dir=firesim_build_dir,
            harness_dir=harness_dir, io_path=io_path,  # type: ignore[arg-type]
            config=FiresimEvalConfig(),
            log=log,
        )
        log(f"optimize: firesim re-rank ENABLED "
            f"(top_k={firesim_top_k}, build_dir={firesim_build_dir})")

    # See module-level LLM_SKIP_OPS_PER_TARGET for the rationale.
    _skip = LLM_SKIP_OPS_PER_TARGET.get(target.name, set())

    optimize_summary: dict[str, dict] = {}
    for spec in specs:
        if spec.op in _skip:
            log(f"  [{spec.op}] target={target} -> "
                f"optimize-skip (curated/reference is best known)")
            continue
        baseline_op = baseline_cycles_by_op.get(spec.op, 0)
        if baseline_op <= 0:
            log(f"  [{spec.op}] no baseline cycles, skipping")
            continue
        log(f"\noptimize [{spec.op}] baseline={baseline_op}")
        shapes = collect_shapes(ir, spec.op, spec)
        best_code, best_cycles, history, viable = beam_search_optimize(
            spec, shapes, impls[spec.op], baseline_op,
            impls=impls, specs=specs, backend=target, client=client,
            optimize_system=optimize_system,
            repo_root=repo_root,  # type: ignore[arg-type]
            model_dir=out_dir,
            build_dir=build_dir,  # type: ignore[arg-type]
            harness_dir=harness_dir, io_path=io_path,
            beam=beam, expansions=expansions, iterations=iterations,
            log=log,
        )

        # FireSim re-rank: take the spike top-K survivors + spike-best
        # baseline and re-score on real RTL. Whichever has the lowest
        # firesim cycles wins for cache promotion. The spike-best stays
        # in `impls` as the in-process working copy (we don't want to
        # let firesim regress correctness silently).
        firesim_history: list[dict] = []
        firesim_best_cycles: Optional[int] = None
        if firesim_evaluator is not None and viable:
            run_op = (
                firesim_op_filter is None
                or spec.op in firesim_op_filter
            )
            if not run_op:
                log(f"  [{spec.op}/firesim] skipped (not in op filter)")
            else:
                # Build run list: spike-best baseline + top-K unique candidates.
                _seen_norm: set[str] = set()
                _run_list: list[tuple[str, str]] = []  # (label, code)
                _base_key = _normalize(best_code)
                _seen_norm.add(_base_key)
                _run_list.append(("baseline", best_code))
                for _i, (_code, _cyc) in enumerate(viable[:firesim_top_k]):
                    _key = _normalize(_code)
                    if _key in _seen_norm:
                        continue
                    _seen_norm.add(_key)
                    _run_list.append((f"top-{_i+1}", _code))

                log(f"  [{spec.op}/firesim] batch re-ranking "
                    f"{len(_run_list)} candidate(s) in 1 firesim boot")

                from modelblaster.optimize.batch_eval import BatchEvaluator
                _batch = BatchEvaluator(
                    shared_model_dir=firesim_evaluator.model_dir,
                    build_dir=firesim_evaluator.firesim_build_dir,
                    backend=firesim_evaluator.backend,
                    specs=firesim_evaluator.specs,
                    io_path=firesim_evaluator.io_path,
                    repo_root=firesim_evaluator.repo_root,
                    runner="firesim",
                    firesim_config=firesim_evaluator.config,
                    harness_dir=firesim_evaluator.harness_dir,
                    impls=firesim_evaluator.impls,
                    log=log,
                )
                _batch_results = _batch.evaluate(_run_list, spec=spec)

                fbest_code = None
                fbest_cycles = None
                for _label, _code in _run_list:
                    _r = _batch_results.get(_label)
                    firesim_history.append({
                        "label": _label,
                        "spike_cycles": best_cycles if _label == "baseline" else None,
                        "firesim_cycles": _r.cycles_for_op if _r else None,
                        "firesim_ok": _r.ok if _r else False,
                        "golden_ok": _r.golden_ok if _r else None,
                        "diagnostic": (_r.diagnostic[:300] if _r else "no result"),
                    })
                    if _r and _r.ok and _r.cycles_for_op is not None:
                        log(f"  [{spec.op}/firesim] {_label}: "
                            f"{_r.cycles_for_op} cyc "
                            f"(golden={'PASS' if _r.golden_ok else 'FAIL'})")
                        if fbest_cycles is None or _r.cycles_for_op < fbest_cycles:
                            fbest_code = _code
                            fbest_cycles = _r.cycles_for_op
                    else:
                        log(f"  [{spec.op}/firesim] {_label}: FAILED "
                            f"({(_r.diagnostic if _r else 'no result')[:120]})")

                if fbest_code is not None and fbest_cycles is not None:
                    firesim_best_cycles = fbest_cycles
                    if _normalize(fbest_code) != _normalize(best_code):
                        log(f"  [{spec.op}/firesim] promoting firesim-best "
                            f"({fbest_cycles} cyc) over spike-best")
                        best_code = fbest_code

        impls[spec.op] = best_code
        optimize_summary[spec.op] = {
            "baseline": baseline_op,
            "best": best_cycles,
            "improvement_pct": (baseline_op - best_cycles) / baseline_op * 100.0,
            "history": history,
            "firesim_history": firesim_history,
            "firesim_best_cycles": firesim_best_cycles,
        }
        # Persist the optimized kernel back to the same cache slot the
        # baseline read from so a subsequent OPTIMIZE=0 sweep finds the
        # already-improved code on cache HIT and reuses it. Only overwrite
        # when we actually found an improvement — preserves the
        # "baseline LLM" cached file otherwise.
        if cache_dir and best_cycles < baseline_op and spec.op in chosen_algo:
            os.makedirs(cache_dir, exist_ok=True)
            cache_path = os.path.join(
                cache_dir,
                f"{target.name}_{spec.op}_{chosen_algo[spec.op]}.c",
            )
            with open(cache_path, "w") as f:
                f.write(best_code)
            log(f"  [{spec.op}] cached optimized -> {cache_path}")

    emit_kernels_h(specs, out_dir, model_name=ir["name"])
    emit_kernels_c(impls, f"{backend_name}-optimized", out_dir, backend=target, model_name=ir["name"])
    print(f"\nwrote {os.path.join(out_dir, 'kernels.c')}  "
          f"(source={backend_name}-optimized target={target.name})")

    summary_path = os.path.join(out_dir, "optimize_summary.json")
    with open(summary_path, "w") as f:
        json.dump(optimize_summary, f, indent=2)
    log(f"wrote {summary_path}")

    # beam_search_trajectory.jsonl: one line per candidate (across
    # every op + iter + parent + expansion in this optimize call) so
    # the harness can answer "did we plateau early?" / "how much did
    # we pay per surviving candidate?" / "what was the best-of-K
    # curve?" without re-parsing the nested summary.
    trajectory_path = os.path.join(out_dir, "beam_search_trajectory.jsonl")
    with open(trajectory_path, "w") as f:
        for op, entry in optimize_summary.items():
            baseline = entry.get("baseline")
            for rec in entry.get("history") or []:
                line = {"spec": op, "baseline_cycles": baseline}
                line.update(rec)
                f.write(json.dumps(line) + "\n")
    log(f"wrote {trajectory_path}")
    log("")
    log("optimize summary:")
    for op, s in sorted(optimize_summary.items()):
        log(f"  {op}: {s['baseline']} -> {s['best']} ({s['improvement_pct']:+.1f}%)")


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--ir", required=True, help="graph.json")
    ap.add_argument("--out-dir", required=True,
                    help="output dir for kernels.{c,h} and skeleton C")
    ap.add_argument("--backend", choices=["reference", "llm"], default="reference",
                    help="source of kernel implementations")
    ap.add_argument("--target", default="scalar",
                    help=f"HW backend ({sorted(backends_mod.BACKENDS)})")
    ap.add_argument("--max-retries", type=int, default=4)
    ap.add_argument("--optimize", action="store_true")
    ap.add_argument("--beam", type=int, default=2)
    ap.add_argument("--expansions", type=int, default=3)
    ap.add_argument("--iterations", type=int, default=2)
    ap.add_argument("--repo-root", default=None)
    ap.add_argument("--build-dir", default=None)
    ap.add_argument("--harness-dir", default="modelblaster/harness")
    ap.add_argument("--io", default=None,
                    help="io.npz with the PyTorch golden output (required for "
                         "spike-harness verify and --optimize)")
    ap.add_argument("--global-curated-dir", default=None,
                    help="root of the global curated kernel library "
                         "(<root>/<target>/<backend>_<op>_<algo>.c). "
                         "Probed before the per-model cache; hits are "
                         "promoted into the per-model cache on first use.")
    ap.add_argument("--cache-dir", default=None,
                    help="reuse PASSing kernels from this dir across runs "
                         "(saves <target>_<op>_<algo>.c on success, "
                         "reverifies on hit)")
    ap.add_argument("--algorithms", default="all",
                    help=("comma-separated algorithm names to try (in order) "
                          "for each op, or 'all' (default) to try every "
                          "algorithm registered on each spec, or 'default' "
                          "to use only the first algorithm of each spec "
                          "(matches old single-seed behavior)"))
    ap.add_argument("--quant", default="fp32", choices=["fp32", "fp16", "int8"],
                    help="quantization mode. Must match the IR's recorded "
                         "quant or generate_kernels errors out.")
    ap.add_argument("--max-accuracy-class",
                    choices=[c.name.lower() for c in AccuracyClass],
                    default=None,
                    help="restrict kernel selection to algorithms that meet at "
                         "least this accuracy class. 'bit_exact' = max_abs_err=0 "
                         "vs reference; 'numeric_drift' = ≤~1 LSB/layer "
                         "(default behavior, atol=8); 'approximate' = no "
                         "tolerance bound, only validated against task metric. "
                         "When the queue is empty after filtering, the run "
                         "errors out — use this for golden-regression mode.")
    ap.add_argument("--firesim-eval", action="store_true",
                    help="opt-in: after the spike beam search, re-rank the "
                         "top-K spike survivors on FireSim RTL and promote "
                         "the firesim-best to cache. Expensive (1-3 min "
                         "FPGA build+run per candidate) but the only way "
                         "to capture cache-locality wins. Requires --io.")
    ap.add_argument("--firesim-top-k", type=int, default=3,
                    help="how many spike-best candidates to re-score on "
                         "firesim per op. Total firesim runs per op = K + 1 "
                         "(K survivors + the spike-baseline). Default 3.")
    ap.add_argument("--cache-aware-prompt", action="store_true",
                    help="splice the target's memory-hierarchy stanza into "
                         "the optimize-phase system prompt. Steers the LLM "
                         "toward cache-locality wins. Only useful with "
                         "--firesim-eval (otherwise the scorer is blind).")
    ap.add_argument("--firesim-ops", default=None,
                    help="comma-separated op kinds to firesim re-rank. "
                         "Useful when iterating on just conv2d / linear "
                         "without paying FPGA time on every elementwise op. "
                         "Default (unset) = all ops.")
    args = ap.parse_args()

    if args.algorithms == "all":
        algorithm_filter = None
    elif args.algorithms == "default":
        # Use only the first algorithm of each spec — restored single-seed
        # behavior for back-compat / debugging.
        first_names = {spec.algorithms[0].name for spec in KERNEL_SPECS.values()}
        algorithm_filter = first_names
    else:
        algorithm_filter = {n.strip() for n in args.algorithms.split(",") if n.strip()}

    firesim_op_filter = None
    if args.firesim_ops:
        firesim_op_filter = {
            n.strip() for n in args.firesim_ops.split(",") if n.strip()
        }

    generate(
        args.ir, args.out_dir, args.backend, args.target,
        max_retries=args.max_retries,
        optimize=args.optimize,
        beam=args.beam, expansions=args.expansions, iterations=args.iterations,
        repo_root=args.repo_root, build_dir=args.build_dir,
        harness_dir=args.harness_dir, io_path=args.io,
        cache_dir=args.cache_dir,
        algorithm_filter=algorithm_filter,
        global_curated_dir=args.global_curated_dir,
        max_accuracy_class=(
            AccuracyClass.parse(args.max_accuracy_class)
            if args.max_accuracy_class else None
        ),
        quant=args.quant,
        firesim_eval=args.firesim_eval,
        firesim_top_k=args.firesim_top_k,
        cache_aware_prompt=args.cache_aware_prompt,
        firesim_op_filter=firesim_op_filter,
    )


if __name__ == "__main__":
    main()
