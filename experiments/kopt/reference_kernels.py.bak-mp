def _cat4_c1_s8_argtypes():
    import ctypes
    i8p = ctypes.POINTER(ctypes.c_int8)
    return [i8p, ctypes.c_int, ctypes.c_float,
            i8p, ctypes.c_int, ctypes.c_float,
            i8p, ctypes.c_int, ctypes.c_float,
            i8p, ctypes.c_int, ctypes.c_float,
            i8p,
