def _conv2d_argtypes():
    import ctypes
    fp = ctypes.POINTER(ctypes.c_float)
    # input, weight, bias, output, N, IC, IH, IW, OC, KH, KW, SH, SW, PH, PW
    return [fp, fp, fp, fp] + [ctypes.c_int] * 11


