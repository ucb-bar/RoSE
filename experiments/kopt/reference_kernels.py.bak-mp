    ),
    reference_impl="""\
void kernel_prod_dim(const float *input, float *output,
                     int outer, int reduce, int inner) {
    for (int o = 0; o < outer; o++) {
        for (int i = 0; i < inner; i++) {
            float acc = 1.0f;
            for (int r = 0; r < reduce; r++) {
