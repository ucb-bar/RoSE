     total_time += avg_op_time;
 
-    ET_LOG(
-        Info, ">>, %s, %" PRId64 " (%f)", op_name, op_timings_[i], avg_op_time);
+    // printf, not ET_LOG(Info). These `>>` lines are the ONLY reason to build
